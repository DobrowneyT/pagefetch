# Copy to .env and fill in. .env is gitignored; never commit the real token.
# Keep the token in a password manager or direnv, not in this repo.

PAGEFETCH_BIND=127.0.0.1
PAGEFETCH_PORT=8790
PAGEFETCH_TOKEN=generate-a-random-token-here

# Cache
PAGEFETCH_CACHE_TTL_SECONDS=604800

# Politeness (server-side; callers cannot override these)
PAGEFETCH_MIN_DOMAIN_INTERVAL_SECONDS=5
PAGEFETCH_MAX_REQUESTS_PER_DOMAIN_HOUR=20
PAGEFETCH_MAX_CONCURRENCY=2
PAGEFETCH_BENCH_MINUTES=60
PAGEFETCH_BLOCKS_BEFORE_DISABLE=3

# How long a CDN interstitial gets to clear itself before we call it blocked.
# This is waiting, not solving — see src/browser.ts settleChallenge.
PAGEFETCH_CHALLENGE_BUDGET_MS=15000

# robots.txt
PAGEFETCH_ROBOTS_TTL_SECONDS=86400
# Per-domain robots overrides. A CONFIG entry, never a request parameter.
# Empty means robots is respected everywhere, which is the default and the point.
PAGEFETCH_ROBOTS_OVERRIDE=

# The mirror image: hosts refused outright, whatever their robots.txt permits.
# For a site that has asked us directly, or whose terms say more than its
# robots.txt does. Host-level only — path granularity is what robots.txt is for.
PAGEFETCH_ROBOTS_DENY=

# Where the durable store lives (cache, robots policy, and later bench state).
PAGEFETCH_CACHE_PATH=/data/pagefetch.db

# Restart the browser once its process tree exceeds this. Chromium leaks over days.
PAGEFETCH_MEMORY_RESTART_MB=1200
# Per-domain browser contexts kept open before the least recently used is retired.
PAGEFETCH_MAX_CONTEXTS=20
